# ─── Release Keystore Configuration ───────────────────────────────────────────
# Copy this file to android/keystore.properties and fill in your real values.
# NEVER commit keystore.properties to version control.
#
# Generate a keystore with:
#   keytool -genkeypair \
#     -v \
#     -storetype PKCS12 \
#     -keystore android/app/release.keystore \
#     -alias sampleapp-key \
#     -keyalg RSA \
#     -keysize 2048 \
#     -validity 10000
#
# Then update the values below.
# ──────────────────────────────────────────────────────────────────────────────

STORE_FILE=release.keystore
STORE_PASSWORD=your_store_password_here
KEY_ALIAS=sampleapp-key
KEY_PASSWORD=your_key_password_here
