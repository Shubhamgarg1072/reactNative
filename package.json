{
  "name": "sampleFirstAppReact",
  "version": "0.0.1",
  "private": true,
 "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "test": "jest",

    "android": "react-native run-android --mode=developmentDebug --appId=com.samplefirstappreact.dev",
    "android:dev": "react-native run-android --mode=developmentDebug --appId=com.samplefirstappreact.dev",
    "android:staging": "react-native run-android --mode=stagingDebug --appId=com.samplefirstappreact.staging",
    "android:prod": "react-native run-android --mode=productionDebug --appId=com.samplefirstappreact",

    "build:apk:dev": "cd android && ./gradlew assembleDevelopmentRelease",
    "build:apk:staging": "cd android && ./gradlew assembleStagingRelease",
    "build:apk:prod": "cd android && ./gradlew assembleProductionRelease",

    "build:aab:staging": "cd android && ./gradlew bundleStagingRelease",
    "build:aab:prod": "cd android && ./gradlew bundleProductionRelease",

    "clean:android": "cd android && ./gradlew clean"
},
  "dependencies": {
    "@react-native/new-app-screen": "0.83.1",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "@reduxjs/toolkit": "^2.11.2",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-bootsplash": "^7.0.2",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-vector-icons": "^10.3.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
